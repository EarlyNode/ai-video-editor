!brands/general/**/*.jpg
!brands/general/**/*.jpeg
!brands/general/**/*.gif
!brands/general/**/*.webp
!brands/general/**/*.avif

# Episode-specific nameplates contain guest names and source-video stills
/brands/ReactSquad/podcast/nameplates/*.png

# Episode-specific composites and unverified avatar assets stay local
/brands/ReactSquad/podcast/side-by-side/brand-bg.png
/.agents/skills/hyperframes-animation/examples/assets/avatars/

